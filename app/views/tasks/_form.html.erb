<%= form_with model: task, data: { turbo: false } do |f| %>
    <% if task.errors.any? %>
    <div class="error-explanation">
      <h2><%= pluralize(task.errors.count, "件") %>のエラーがあります</h2>
      <ul>
        <% task.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= f.label :title, "タイトル" %>
    <%= f.text_field :title %>
  </div>
  <div>
    <%= f.label :description, "詳細" %>
    <%= f.text_area :description %>
  </div>
  <div>
    <%= f.label :due_date, "期限" %>
    <%= f.date_field :due_date %>
  </div>
  <%= f.submit %>
<% end %>