<section class="side-box">
  <h2>メニュー</h2>
  <ul class="side-menu">
    <li><%= link_to "ホーム", root_path %></li>
    <li><%= link_to "タスク一覧", tasks_path %></li>
    <li><%= link_to "タスクを追加", new_task_path %></li>
  </ul>
</section>

<section class="side-box">
  <h2>タスクの状況</h2>
  <dl class="side-stats">
    <dt>登録数</dt>
    <dd><%= @sidebar_task_count %> 件</dd>
    <dt>期限切れ</dt>
    <dd><%= @sidebar_overdue_count %> 件</dd>
  </dl>
</section>

<section class="side-box">
  <h2>期限が近いタスク</h2>
  <% if @sidebar_upcoming_tasks.any? %>
    <ul class="side-upcoming">
      <% @sidebar_upcoming_tasks.each do |task| %>
        <li>
          <%= link_to task.title, task_path(task) %>
          <%= due_badge(task) %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="side-empty">予定されているタスクはありません。</p>
  <% end %>
</section>